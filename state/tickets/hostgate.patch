diff --git a/tests/test_sched_human_only.py b/tests/test_sched_human_only.py
new file mode 100644
index 0000000..ca5751d
--- /dev/null
+++ b/tests/test_sched_human_only.py
@@ -0,0 +1,57 @@
+"""Regressions for the (human-only) dispatch gate in lib/sched.py (plan()/cmd_next).
+
+Run: .venv/bin/python -m unittest discover -s tests -p 'test_*.py'
+"""
+import importlib.util
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "lib"))   # prompt() imports taskcontract
+spec = importlib.util.spec_from_file_location("sched", ROOT / "lib" / "sched.py")
+sched = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(sched)
+
+
+class HumanOnlyGate(unittest.TestCase):
+    def repo(self, body, extra=()):
+        d = Path(tempfile.mkdtemp(prefix="schedh-"))
+        (d / "TODO.md").write_text(body)
+        for p in extra:
+            (d / p).write_text("x")
+        return d
+
+    def states(self, d):
+        return {sched.split_title(e["text"])[0]: (s, w)
+                for e, s, w in sched.plan(sched.Files(d), {}, {})}
+
+    def test_plain_tag_held_rest_ready(self):
+        d = self.repo("- [ ] **A** — first (after: -) (id: a)\n"
+                      "- [ ] **H** — human line (id: h) (human-only) (after: -)\n")
+        s = self.states(d)
+        self.assertEqual(s["A"][0], "ready")
+        self.assertEqual(s["H"], ("human-only", "human-only"))
+
+    def test_release_path(self):
+        body = "- [ ] **R** — released line (id: r) (human-only: gate.txt) (after: -)\n"
+        self.assertEqual(self.states(self.repo(body))["R"][0], "human-only")
+        self.assertEqual(self.states(self.repo(body, extra=("gate.txt",)))["R"], ("ready", ""))
+
+    def test_held_only_terminates(self):
+        d = self.repo("- [ ] **H** — only line (id: h) (human-only) (after: -)\n")
+        code, out = sched.cmd_next(sched.State(d / "st"), "w1", d, None)
+        self.assertEqual(code, 10)
+        self.assertEqual(out["held"], ["H"])
+
+    def test_agent_line_below_held_is_claimed(self):
+        d = self.repo("- [ ] **H** — hold (id: h) (human-only) (after: -)\n"
+                      "- [ ] **A** — go (after: -) (id: a)\n")
+        code, out = sched.cmd_next(sched.State(d / "st"), "w1", d, None)
+        self.assertEqual(code, 0)
+        self.assertEqual(out["title"], "A")
+
+
+if __name__ == "__main__":
+    unittest.main()
